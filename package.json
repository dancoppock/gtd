{
  "name": "gtd",
  "private": true,
  "description": "Kanban todos app starter blueprint",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node ./scripts/dev-api.mjs",
    "dev:web": "node ./scripts/dev-web.mjs",
    "docker:build": "docker compose -f docker-compose.yml build",
    "docker:down": "docker compose -f docker-compose.yml down",
    "docker:up": "docker compose -f docker-compose.yml up -d",
    "stop:api": "node ./scripts/stop-api.mjs",
    "stop:web": "node ./scripts/stop-web.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --parallel --if-present test:watch",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test e2e",
    "test:e2e:headed": "playwright test e2e --project=chrome --headed",
    "test:e2e:debug": "playwright test e2e --project=chrome --debug --workers=1",
    "test:e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
